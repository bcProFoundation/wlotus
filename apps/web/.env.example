# W Lotus web — Offer client (mobile-first)
# Defaults in code are live WLOTUS (felt a41bf9d0…). Override for a local dryrun.
# VITE_PRAYER_TICKER=WLOTUS
# VITE_PRAYER_TOKEN_ID=a41bf9d03961a2be83f854c8cea0b3fddf7e275ff3695d9848046052d6db3df9
# Empty = same-origin / Vite proxy to mint API
# VITE_MINT_API_BASE=
# Empty = same-origin `/index-api` (dana-index)
# VITE_DANA_INDEX_BASE=

# Temple Dana explorer (decoded memorials). Default https://danaverse.org
# VITE_DANA_EXPLORER_ORIGIN=https://danaverse.org

# Soft pray floor after remint, before memorial burn.
# Default 108 seconds (~2 min — one second per mala bead). Set 0 to disable.
# Runtime override: localStorage wlotus.minPraySeconds
# VITE_MIN_PRAY_SECONDS=108

# Launch mining: WebGPU → multi-worker → single (requires rebuild).
# See docs/research/phone-webgpu-wasm-mining.md
# VITE_EXPERIMENTAL_POW=1
# Optional: auto | webgpu | multi-worker | worker
# VITE_POW_BACKEND=auto
