[Unit]
Description=WLotus Prayer mint API (dual-mint)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/wlotus
# Do NOT use EnvironmentFile for MINT_MNEMONIC (spaces break systemd).
# loadMintEnv.boot.ts loads /etc/wlotus/mint.env via dotenv *before* offer.ts
# reads MINT_SERVING_TIP_INDEX. File must be readable by User=deploy:
# chown root:deploy && chmod 640 (not 600 root:root).
Environment=NODE_ENV=production
Environment=MINT_API_PORT=8787
ExecStartPre=/usr/bin/test -x /opt/wlotus/node_modules/.bin/tsx
ExecStart=/opt/wlotus/deploy/contabo/run-mint-api.sh
Restart=on-failure
RestartSec=5
# Long remint PoW can take minutes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
