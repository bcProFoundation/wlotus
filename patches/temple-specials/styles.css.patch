diff --git a/apps/web/src/styles.css b/apps/web/src/styles.css
index fe366f1..83b16cb 100644
--- a/apps/web/src/styles.css
+++ b/apps/web/src/styles.css
@@ -1668,3 +1668,41 @@ a {
   color: var(--muted);
   font-size: 0.85rem;
 }
+
+
+/* Temple special story during soft pray / offer session */
+.temple-story {
+  margin: 0 0 1rem;
+  padding: 0.85rem 1rem;
+  border-radius: 12px;
+  background: color-mix(in srgb, var(--surface, #1a1a1a) 88%, #c9a227 12%);
+  border: 1px solid color-mix(in srgb, #c9a227 35%, transparent);
+  max-height: 40vh;
+  overflow-y: auto;
+}
+.temple-story-heading {
+  margin: 0 0 0.25rem;
+  font-size: 0.75rem;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  opacity: 0.75;
+}
+.temple-story-hint {
+  margin: 0 0 0.65rem;
+  font-size: 0.8rem;
+  opacity: 0.85;
+}
+.temple-story-title {
+  margin: 0 0 0.5rem;
+  font-size: 1.05rem;
+  font-weight: 600;
+}
+.temple-story-para {
+  margin: 0 0 0.55rem;
+  font-size: 0.9rem;
+  line-height: 1.55;
+  white-space: pre-wrap;
+}
+.temple-story-para:last-child {
+  margin-bottom: 0;
+}
