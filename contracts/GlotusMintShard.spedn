// GlotusMintShard — two-shard Ergon-δ MINT shard (M), mint-only v1.
//
// Stateless head (tokenId + mint atoms only): M derives nothing. Checks
// PoW against witness (newDay, newTarget), pins the full 4-output set
// byte-identical to C. (newDay, newTarget) are bound to C's derived
// values through identical output pins — any mismatch makes the tx
// unsatisfiable. Sibling pin (index 1, sibling C at index 0, sibling
// BODY hash) hand-spliced by TS; see src/covenant/twoShardScript.ts.
//
// v1 DIET: successors unverified witness (ergon-dogfood posture — see
// GlotusComputeShard.spedn); length literals 0x11/0x32/0x47; single
// tail split. Full successor verification deferred to v2.

contract GlotusMintShard(
    [byte;32] tokenIdRev,
    [byte;6] mintAtomsLe
) {
    challenge remint(
        [byte;4] nonce,
        Sig s,
        DataSig ds,
        PubKey minerPk,
        int newDay,
        int newTarget,
        [byte] preimage,
        [byte] nextCRedeem,
        [byte] nextMRedeem
    ) {
        [byte] solhash = hash256(sha256(preimage) . nonce);
        ([byte] head, _) = solhash @ 4;
        verify bin2num(head) >= 0;
        verify bin2num(head) < newTarget;

        (_, [byte] tail40) = preimage @ (size(preimage) - 40);
        ([byte] hashOutputs, [byte] tail8) = tail40 @ 32;
        ([byte] locktimeBin, _) = tail8 @ 4;
        int locktime = bin2num(locktimeBin);

        [byte] wldf =
            0x574c4446 .
            0x03 .
            num2bin(newDay, 4) .
            num2bin(newTarget, 4) .
            num2bin(locktime, 4);

        [byte] mintSection =
            0x534c5032 .
            0x00 .
            0x04 . 0x4d494e54 .
            tokenIdRev .
            0x01 .
            mintAtomsLe .
            0x02;

        [byte] opReturnScript =
            0x6a50 .
            0x11 .
            wldf .
            0x32 .
            mintSection;

        [byte] out0 = 0x0000000000000000 . 0x47 . opReturnScript;
        [byte] out1 = 0x2202000000000000 . 0x19 . 0x76a914 . hash160(minerPk) . 0x88ac;
        [byte] out2 = 0x2202000000000000 . 0x17 . 0xa914 . hash160(nextCRedeem) . 0x87;
        [byte] out3 = 0x2202000000000000 . 0x17 . 0xa914 . hash160(nextMRedeem) . 0x87;

        verify hash256(out0 . out1 . out2 . out3) == Sha256(hashOutputs);

        separator;
        verify checkSig(s, minerPk);
        verify checkDataSig(ds, sha256(preimage), minerPk);
    }
}
