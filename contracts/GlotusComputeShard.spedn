// GlotusComputeShard — two-shard Ergon-δ COMPUTE shard (C), mint-only v1.
//
// Bakes (tipDay, tipTarget). Derives (newDay, newTarget) from the tx
// locktime with a K=1 step cap, pins the full 4-output set
// [OP_RETURN | miner P2PKH | C' P2SH | M' P2SH].
// Cross-consistency with M comes from identical output pins: any
// (newDay, newTarget) ≠ C's derived values makes the shards disagree
// on hashOutputs, so the tx cannot satisfy both.
//
// Sibling pin (this input is index 0, sibling M is index 1, plus the
// sibling BODY hash) is hand-spliced by TS: Spedn 5.0 cannot emit
// 0xc0–0xcd. See src/covenant/twoShardScript.ts.
// Canonical step (SUB form, explicit double-and-add — no OP_MUL):
//   t ← t − floor(t·82 / 100000)
//
// v1 DIET (budget-forced, all documented):
// - K=1, not K=3: Spedn's stack-shuffling overhead (~2× logic) leaves
//   no room for 3 unrolled steps. The bounded-chain mechanism is what
//   the experiment proves; K is a constant. K=3 wants hand-assembly.
// - Successors (nextCRedeem/nextMRedeem) are UNVERIFIED witness, exactly
//   like the live ergon dogfood's batonHash: the honest miner builds
//   them correctly, and a hostile miner can only steal a worthless
//   research token (same posture as the ergon dogfood). Full shell+state
//   successor verification is deferred to v2 (proven technique — the
//   live MooreTip contracts do it; it just doesn't fit beside the
//   derivation in Spedn output).
// - Length literals (0x11/0x32/0x47): the eMPP section lengths are
//   consensus-fixed by construction; literals emit byte-identical
//   output to SIZE+NUM2BIN. See tests/twoShard.test.ts.
// - Single tail split reads locktime + hashOutputs together.

contract GlotusComputeShard(
    [byte;32] tokenIdRev,
    [byte;6] mintAtomsLe,
    [byte;4] genesisUnixLe,
    [byte;4] daySecondsLe,
    [byte;4] tipDayLe,
    [byte;4] tipTargetLe
) {
    challenge remint(
        PubKey minerPk,
        int newTarget,
        [byte] preimage,
        [byte] nextCRedeem,
        [byte] nextMRedeem
    ) {
        int genesisUnix = bin2num(genesisUnixLe);
        int daySeconds = bin2num(daySecondsLe);
        int tipDay = bin2num(tipDayLe);
        int tipTarget = bin2num(tipTargetLe);

        (_, [byte] tail40) = preimage @ (size(preimage) - 40);
        ([byte] hashOutputs, [byte] tail8) = tail40 @ 32;
        ([byte] locktimeBin, _) = tail8 @ 4;
        int locktime = bin2num(locktimeBin);
        int newDay = (locktime - genesisUnix) / daySeconds;
        int k = newDay - tipDay;
        verify k >= 0;
        verify k <= 1;

        // The single δ step, always computed; the two verify-only
        // branches bind the witness newTarget to step k.
        int t0 = tipTarget;
        int t2 = t0 + t0;
        int t4 = t2 + t2;
        int t8 = t4 + t4;
        int t16 = t8 + t8;
        int t32 = t16 + t16;
        int t64 = t32 + t32;
        int t82 = t64 + t16 + t2;
        int s1 = t0 - (t82 / 100000);
        if (k == 0) {
            verify newTarget == t0;
        }
        if (k == 1) {
            verify newTarget == s1;
        }

        [byte] wldf =
            0x574c4446 .
            0x03 .
            num2bin(newDay, 4) .
            num2bin(newTarget, 4) .
            num2bin(locktime, 4);

        [byte] mintSection =
            0x534c5032 .
            0x00 .
            0x04 . 0x4d494e54 .
            tokenIdRev .
            0x01 .
            mintAtomsLe .
            0x02;

        [byte] opReturnScript =
            0x6a50 .
            0x11 .
            wldf .
            0x32 .
            mintSection;

        [byte] out0 = 0x0000000000000000 . 0x47 . opReturnScript;
        [byte] out1 = 0x2202000000000000 . 0x19 . 0x76a914 . hash160(minerPk) . 0x88ac;
        [byte] out2 = 0x2202000000000000 . 0x17 . 0xa914 . hash160(nextCRedeem) . 0x87;
        [byte] out3 = 0x2202000000000000 . 0x17 . 0xa914 . hash160(nextMRedeem) . 0x87;

        verify hash256(out0 . out1 . out2 . out3) == Sha256(hashOutputs);
    }
}
